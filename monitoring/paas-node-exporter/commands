# interval,metric_name,command,is_string
# Six NIC counters (per driver): RX buffer | RX drop | TX drop
30,nic_enic_rx_buffer,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; ethtool -i "$n" 2>/dev/null | grep -q 'driver: enic' || continue; ethtool -S "$n" 2>/dev/null | awk '/rx_no_bufs:/{print $2+0; exit}'; exit; done; echo 0,False
30,nic_vmxnet3_rx_buffer,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; ethtool -i "$n" 2>/dev/null | grep -q 'driver: vmxnet3' || continue; ethtool -S "$n" 2>/dev/null | awk '/pkts rx OOB:/{s+=$4} END{print s+0}'; exit; done; echo 0,False
30,nic_enic_rx_drop,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; ethtool -i "$n" 2>/dev/null | grep -q 'driver: enic' || continue; ethtool -S "$n" 2>/dev/null | awk '/^[[:space:]]*rx_drop:/{print $2+0; exit}'; exit; done; echo 0,False
30,nic_vmxnet3_rx_drop,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; ethtool -i "$n" 2>/dev/null | grep -q 'driver: vmxnet3' || continue; ethtool -S "$n" 2>/dev/null | awk '/drv dropped rx total:/{s+=$5} END{print s+0}'; exit; done; echo 0,False
30,nic_enic_tx_drop,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; ethtool -i "$n" 2>/dev/null | grep -q 'driver: enic' || continue; ethtool -S "$n" 2>/dev/null | awk '/^[[:space:]]*tx_drop:/{print $2+0; exit}'; exit; done; echo 0,False
30,nic_vmxnet3_tx_drop,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; ethtool -i "$n" 2>/dev/null | grep -q 'driver: vmxnet3' || continue; ethtool -S "$n" 2>/dev/null | awk '/ring full:/{s+=$3} END{print s+0}'; exit; done; echo 0,False
30,nic_ring_rx_current,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; d=$(ethtool -i "$n" 2>/dev/null | awk '/^driver:/{print $2}'); case "$d" in ''|bridge|openvswitch|veth|tun|geneve|vxlan) continue;; esac; ethtool -g "$n" 2>/dev/null | awk '/Current hardware settings:/{c=1} c&&/^RX:/{print $2; exit}'; exit; done; echo 0,False
30,nic_ring_rx_max,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; d=$(ethtool -i "$n" 2>/dev/null | awk '/^driver:/{print $2}'); case "$d" in ''|bridge|openvswitch|veth|tun|geneve|vxlan) continue;; esac; ethtool -g "$n" 2>/dev/null | awk '/Pre-set maximums:/{c=1} c&&/^RX:/{print $2; exit}'; exit; done; echo 0,False
30,nic_ring_tx_current,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; d=$(ethtool -i "$n" 2>/dev/null | awk '/^driver:/{print $2}'); case "$d" in ''|bridge|openvswitch|veth|tun|geneve|vxlan) continue;; esac; ethtool -g "$n" 2>/dev/null | awk '/Current hardware settings:/{c=1} c&&/^TX:/{print $2; exit}'; exit; done; echo 0,False
30,nic_ring_tx_max,for i in /sys/class/net/*; do n=${i##*/}; [ "$(cat $i/type 2>/dev/null)" = 1 ] || continue; d=$(ethtool -i "$n" 2>/dev/null | awk '/^driver:/{print $2}'); case "$d" in ''|bridge|openvswitch|veth|tun|geneve|vxlan) continue;; esac; ethtool -g "$n" 2>/dev/null | awk '/Pre-set maximums:/{c=1} c&&/^TX:/{print $2; exit}'; exit; done; echo 0,False
