          "type": "prometheus"
        },
        "definition": "label_values(nic_rx_no_bufs_total, device)",
        "includeAll": true,
        "multi": true,
        "name": "device",
        "query": "label_values(nic_rx_no_bufs_total, device)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
