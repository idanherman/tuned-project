              },
              {
                "color": "yellow",
                "value": 65
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
