    },
    {
      "title": "TX Packets/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 70 },
      "id": 18,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_network_transmit_packets_total{device!~\"veth.*|br.*|ovs.*|lo|genev.*\",instance=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "RX Bandwidth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 70 },
      "id": 19,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"veth.*|br.*|ovs.*|lo|genev.*\",instance=~\"$node\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "TX Bandwidth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 70 },
      "id": 20,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"veth.*|br.*|ovs.*|lo|genev.*\",instance=~\"$node\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 78 },
      "id": 600,
      "title": "Conntrack",
      "type": "row"
    },
    {
      "title": "Conntrack Usage (%) per Node",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 79 },
      "id": 21,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "node_nf_conntrack_entries{instance=~\"$node\"} / node_nf_conntrack_entries_limit{instance=~\"$node\"} * 100",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "Conntrack Entries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 79 },
      "id": 22,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "node_nf_conntrack_entries{instance=~\"$node\"}",
          "legendFormat": "{{instance}} current"
        },
        {
          "expr": "node_nf_conntrack_entries_limit{instance=~\"$node\"}",
          "legendFormat": "Limit {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "Conntrack Drops",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 79 },
      "id": 23,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "rate(node_nf_conntrack_stat_drop{instance=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 87 },
      "id": 800,
      "title": "Thermal & CPU Throttling (bare-metal only — no data on VMs)",
      "type": "row"
    },
    {
      "title": "CPU Temperature (hwmon)",
      "description": "CPU package/core temps from coretemp (Intel) or k10temp (AMD). Alert threshold: 85C.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 88 },
      "id": 26,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "node_hwmon_temp_celsius{instance=~\"$node\",chip=~\".*coretemp.*|.*k10temp.*\"}",
          "legendFormat": "{{instance}} {{sensor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 20,
          "max": 105,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "NIC / Transceiver Temperature",
      "description": "Temperatures from non-CPU hwmon sensors and thermal zones. Overheating SFP+ causes CRC errors and link flaps.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 88 },
      "id": 29,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "node_hwmon_temp_celsius{instance=~\"$node\",chip!~\".*coretemp.*|.*k10temp.*\"}",
          "legendFormat": "{{instance}} {{chip}} {{sensor}}"
        },
        {
          "expr": "node_thermal_zone_temp{instance=~\"$node\"} / 1000",
          "legendFormat": "{{instance}} zone{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 20,
          "max": 105,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 65 },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "CPU Throttle Events (must be 0)",
      "description": "Non-zero means CPU was forced to reduce clock due to thermal limits. Correlate with ring_full spikes.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 88 },
      "id": 27,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "rate(node_cpu_core_throttles_total{instance=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{instance}} core{{cpu}}"
        },
        {
          "expr": "rate(node_cpu_package_throttles_total{instance=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{instance}} pkg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "CPU Frequency (drops = throttling)",
      "description": "Actual clock speed per core. A sudden drop correlates with thermal throttle events.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 88 },
      "id": 28,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "node_cpu_frequency_hertz{instance=~\"$node\"} / 1e9",
          "legendFormat": "{{instance}} cpu{{cpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "GHz",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 96 },
      "id": 900,
      "title": "NIC Link Health",
      "type": "row"
    },
    {
      "title": "Link Speed (Mbps)",
      "description": "nic_link_speed_mbps — negotiated link speed per NIC.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 97 },
      "id": 36,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "nic_link_speed_mbps{node_name=~\"$node\",device=~\"$device\"}",
          "legendFormat": "{{node_name}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nic", "tuning", "network", "openshift"],
  "templating": {
    "list": [
      {
        "type": "datasource",
