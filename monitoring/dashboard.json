    {
      "title": "RX Buffer Exhaustion — cumulative",
      "description": "nic_rx_no_bufs_total — RX buffer exhaustion (ethtool -S)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 40,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "sum by (device) (nic_rx_no_bufs_total{node_name=~\"$node\",device=~\"$device\"}) or vector(0)",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 100000 }
            ]
          }
        }
      }
    },
