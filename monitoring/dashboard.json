    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 700,
      "title": "Ring Buffer Config",
      "type": "row"
    },
    {
      "title": "Ring RX: Current / Max (%)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 24,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "nic_ring_rx_current{node_name=~\"$node\",device=~\"$device\"} / nic_ring_rx_max{node_name=~\"$node\",device=~\"$device\"} * 100",
          "legendFormat": "{{node_name}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textSize": {}
      }
    },
    {
      "title": "Ring TX: Current / Max (%)",
      "type": "bargauge",
