    {
      "title": "Softnet Drops — Cumulative",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 23 },
      "id": 6,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "sum(node_softnet_dropped_total{instance=~\"$node\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "title": "Softnet Drops — Avg/sec (total÷uptime)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 23 },
      "id": 7,
      "datasource": { "type": "datasource", "uid": "$Env" },
      "targets": [
        {
          "expr": "sum(node_softnet_dropped_total{instance=~\"$node\"}) / avg(node_time_seconds{instance=~\"$node\"} - node_boot_time_seconds{instance=~\"$node\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "decimals": 2,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
